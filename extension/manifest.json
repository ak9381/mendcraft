{
  "manifest_version": 3,
  "name": "Mendcraft",
  "version": "0.1.0",
  "description": "Hands-free copy, paste, and tab switching for Mendcraft. Copy from any Chrome tab, send it to the studio canvas, or paste into a field after a pinch confirm. Never reads password or payment fields, and never submits forms.",
  "permissions": ["activeTab", "scripting", "tabs", "storage"],
  "externally_connectable": {
    "matches": [
      "https://mendcraft.web.app/*",
      "https://mendcraft.firebaseapp.com/*",
      "http://localhost:5173/*",
      "http://127.0.0.1:5173/*"
    ]
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": false
    },
    {
      "matches": [
        "https://mendcraft.web.app/*",
        "https://mendcraft.firebaseapp.com/*",
        "http://localhost:5173/*",
        "http://127.0.0.1:5173/*"
      ],
      "js": ["page-bridge.js"],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Mendcraft",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
