<?xml version="1.0" encoding="UTF-8"?>
<!--
  Mendcraft's additions to the generated ios/App/App/Info.plist.

  ios/App is generated by `npx cap add ios` and is NOT committed (it holds the
  signing team). After generating it, merge every key below into the top-level
  <dict> of ios/App/App/Info.plist (replace a key Capacitor already wrote, keep
  everything else). See ios/README.md for the full post-`cap add ios` steps.

  The usage strings are what iOS shows in its permission prompts; keep them
  accurate to what the app actually does.
-->
<plist version="1.0">
<dict>
	<!-- Camera: hand gestures, and the one photo of a device she points at. -->
	<key>NSCameraUsageDescription</key>
	<string>Mendcraft reads your hand gestures and recognises devices you point at.</string>

	<!-- Microphone: voice commands, and the laptop's pairing chime. -->
	<key>NSMicrophoneUsageDescription</key>
	<string>Mendcraft listens for your voice commands and for the laptop's pairing chime.</string>

	<!-- Speech recognition: spoken commands to text. -->
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>Mendcraft turns your spoken commands into text so it can act on them.</string>

	<!-- Local network: WiZ lamp + speakers on the home Wi-Fi (MendcraftLanPlugin). -->
	<key>NSLocalNetworkUsageDescription</key>
	<string>Mendcraft finds and controls your lamp and speakers on your home Wi-Fi.</string>
	<key>NSBonjourServices</key>
	<array>
		<string>_http._tcp</string>
		<string>_hap._tcp</string>
	</array>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>

	<!-- The scene delegate (ios-src/SceneDelegate.swift) roots the app in
	     MendcraftViewController, which registers the Mendcraft plugins. -->
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
		<key>UISceneConfigurations</key>
		<dict>
			<key>UIWindowSceneSessionRoleApplication</key>
			<array>
				<dict>
					<key>UISceneConfigurationName</key>
					<string>Default Configuration</string>
					<key>UISceneDelegateClassName</key>
					<string>$(PRODUCT_MODULE_NAME).SceneDelegate</string>
					<key>UISceneStoryboardFile</key>
					<string>Main</string>
				</dict>
			</array>
		</dict>
	</dict>
</dict>
</plist>
