# Android (project sources in android/ are committed; builds/secrets are not —
# android/.gitignore also covers .gradle/, build/, local.properties)
android/.gradle/
android/build/
android/app/build/
android/capacitor-cordova-android-plugins/build/
*.keystore
*.jks

# iOS (Capacitor) — ios/README.md is committed; the generated Xcode project and
# all build output are not. `npx cap add ios` regenerates ios/App on a Mac.
ios/App/App/public/
ios/App/Pods/
ios/App/build/
ios/App/output/
ios/App/DerivedData/
ios/App/*.xcworkspace/xcuserdata/
ios/App/*.xcodeproj/xcuserdata/
ios/capacitor-cordova-ios-plugins/
*.ipa
*.dSYM.zip
